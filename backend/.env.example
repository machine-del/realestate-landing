PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Keep real credentials in backend/.env; never expose them in frontend variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_PEER_IDS=
VK_API_VERSION=5.199

# Create a Redis database in Upstash and copy its REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
